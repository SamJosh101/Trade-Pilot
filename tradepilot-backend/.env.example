# Copy this file to .env and fill in real values. Never commit .env itself.

# PostgreSQL connection string (Railway / Supabase / Neon / local)
DATABASE_URL="postgresql://username:password@localhost:5432/tradepilot?schema=public"

# Long random string used to sign JWTs — rotating this logs everyone out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

JWT_EXPIRES_IN="7d"

PORT=4000

# The deployed/local frontend origin — CORS only allows this exact origin.
CORS_ORIGIN="http://localhost:5173"

# Defaults off. Production also requires the approved policy and financial table grants.
TRADEPILOT_FINANCIAL_WRITES=false
TRADEPILOT_FINANCIAL_POLICY=

# Keep false on an original database. Set true only after separately approved
# security migration/catalog verification; prevents legacy auth downgrade across restarts.
TRADEPILOT_AUTH_SECURITY_REQUIRED=false

# Private owned media. Enable only after provider/privacy/storage verification.
TRADEPILOT_MEDIA_UPLOADS=false
TRADEPILOT_MEDIA_PRIVATE_VERIFIED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
