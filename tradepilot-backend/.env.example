# Copy this file to .env and fill in real values. Never commit .env itself.

# PostgreSQL connection string (Railway / Supabase / Neon / local)
DATABASE_URL="postgresql://username:password@localhost:5432/tradepilot?schema=public"

# Long random string used to sign JWTs — rotating this logs everyone out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

JWT_EXPIRES_IN="7d"

PORT=4000

# The deployed/local frontend origin — CORS only allows this exact origin.
CORS_ORIGIN="http://localhost:5173"
