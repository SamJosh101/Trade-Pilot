    "test:frontend:postgres": "npm run build && node scripts/verify-financial-postgres.cjs --frontend",
    "test:legacy:postgres": "npm run build && node scripts/verify-financial-postgres.cjs --legacy",
    "test:strategies:postgres": "npm run build && node scripts/verify-financial-postgres.cjs --strategies",
    "test:integrity:postgres": "npm run build && node scripts/verify-financial-postgres.cjs --integrity",
    "test:gameplans:postgres": "npm run build && node scripts/verify-financial-postgres.cjs --gameplans",
    "test:notes:postgres": "npm run build && node scripts/verify-financial-postgres.cjs --notes",
    "test:trade-query:postgres": "npm run build && node scripts/verify-financial-postgres.cjs --trade-query",
    "test:strategy-performance:postgres": "npm run build && node scripts/verify-financial-postgres.cjs --strategy-performance",
    "test:security:postgres": "npm run build && node scripts/verify-financial-postgres.cjs --security"
